# Copier en .env et renseigner les valeurs. Ne jamais versionner .env.

# Source S1 : base opérationnelle PostgreSQL
SOURCE_PG_HOST=host.docker.internal
SOURCE_PG_PORT=5432
SOURCE_PG_DB=postgres
SOURCE_PG_USER=postgres
SOURCE_PG_PASSWORD=

# MinIO (stockage du Lakehouse)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# URL de MinIO vue du poste ; les conteneurs du réseau chu utilisent http://minio:9000 (fixé dans le compose)
MINIO_ENDPOINT=http://localhost:9000

# Pseudonymisation des patients (SHA-256 + sel)
PSEUDO_SALT=

# Airflow (AIRFLOW_DB_PASSWORD entre dans une URL : caractères alphanumériques, ex. openssl rand -hex 16)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_DB_PASSWORD=
# clé de signature des sessions du webserver, ex. openssl rand -hex 32
AIRFLOW_SECRET_KEY=

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# FTP de simulation des sources S3 et S4 (infra/docker-compose.yml)
FTP_HOST=localhost
FTP_PORT=2121
# compte lecture seule des pipelines / Airflow
FTP_USER=chu
FTP_PASSWORD=
# compte du producteur simulé (dépôt des fichiers)
FTP_DEPOT_USER=depot
FTP_DEPOT_PASSWORD=
