# Copier en .env et renseigner les valeurs. Ne jamais versionner .env.

# Source S1 : base opérationnelle PostgreSQL
SOURCE_PG_HOST=host.docker.internal
SOURCE_PG_PORT=5432
SOURCE_PG_DB=postgres
SOURCE_PG_USER=postgres
SOURCE_PG_PASSWORD=

# Base Bronze SQL (schémas bronze_s2, bronze_s3...) : PostgreSQL local
BRONZE_PG_HOST=localhost
BRONZE_PG_PORT=5432
BRONZE_PG_DB=chu_bronze
BRONZE_PG_USER=postgres
BRONZE_PG_PASSWORD=

# Source S3 : dossier Satisfaction du pack DATA 2024
S3_DATA_DIR=data/Satisfaction

# MinIO (stockage du Lakehouse)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Pseudonymisation des patients (SHA-256 + sel)
PSEUDO_SALT=

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
